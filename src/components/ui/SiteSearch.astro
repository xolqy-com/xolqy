---
/**
 * Site search. Without JavaScript the form opens the wiki filter.
 * site-search.ts adds live results and voice input. One instance per id.
 */
interface Props {
  id: string;
  /** Results float under the field. The mobile menu uses normal flow instead. */
  overlay?: boolean;
}
const { id, overlay = false } = Astro.props;
---

<form class:list={['site-search', overlay && 'site-search--overlay']} role="search" action="/wiki/" method="get" data-site-search>
  <label class="visually-hidden" for={id}>Search the site</label>
  <input
    id={id}
    class="site-search__input"
    type="search"
    name="q"
    placeholder="Search"
    autocomplete="off"
    enterkeyhint="search"
    spellcheck="false"
    aria-autocomplete="list"
    aria-controls={`${id}-results`}
    aria-expanded="false"
  />
  <button type="button" class="site-search__mic" data-speech aria-pressed="false" aria-label="Search by voice">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
      <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M12 3.5a3 3 0 0 1 3 3v5a3 3 0 0 1-6 0v-5a3 3 0 0 1 3-3z" />
      <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M6.5 11.5a5.5 5.5 0 0 0 11 0M12 17v3.5" />
    </svg>
  </button>
  <ul id={`${id}-results`} class="site-search__results" role="listbox" hidden data-results></ul>
  <p class="visually-hidden" data-search-status aria-live="polite"></p>
</form>

<style>
  .site-search {
    position: relative;
    display: flex;
    align-items: center;
    min-width: 0;
  }
  .site-search:not(.site-search--overlay) { width: 100%; }
  .site-search:not(.site-search--overlay) .site-search__input { width: 100%; }
  .site-search__input {
    width: 11.5rem;
    min-height: 2.5rem;
    padding: 0.4rem 2.4rem 0.4rem 0.9rem;
    border: 1px solid rgba(245, 245, 240, 0.28);
    border-radius: var(--radius-pill);
    background: rgba(245, 245, 240, 0.06);
    color: var(--paper);
    font: inherit;
    font-size: var(--text-sm);
  }
  .site-search__input::placeholder { color: rgba(245, 245, 240, 0.55); }
  .site-search__input:focus-visible { outline: 2px solid var(--signal); outline-offset: 2px; }
  .site-search__mic {
    position: absolute;
    top: 50%;
    right: 0.2rem;
    transform: translateY(-50%);
    width: 2rem;
    height: 2rem;
    display: inline-grid;
    place-items: center;
    border-radius: var(--radius-pill);
    color: var(--paper);
  }
  .site-search__mic:hover,
  .site-search__mic[aria-pressed='true'] { color: var(--signal); background: rgba(245, 245, 240, 0.08); }
  .site-search__mic:focus-visible { outline: 2px solid var(--signal); outline-offset: 2px; }
  .site-search__mic[hidden] { display: none; }
  .site-search__results {
    position: static;
    margin: 0.45rem 0 0;
    padding: 0.35rem;
    list-style: none;
    background: var(--ink-2, #121212);
    border: 1px solid rgba(245, 245, 240, 0.16);
    border-radius: var(--radius-md);
    max-height: 18rem;
    overflow-y: auto;
  }
  .site-search--overlay .site-search__results {
    position: absolute;
    z-index: 2;
    top: calc(100% + 0.4rem);
    right: 0;
    width: min(24rem, 70vw);
    margin: 0;
  }
  .site-search__results[hidden] { display: none; }
  .site-search__results a {
    display: grid;
    gap: 0.1rem;
    padding: 0.55rem 0.7rem;
    border-radius: 0.4rem;
    text-decoration: none;
    color: var(--paper);
  }
  .site-search__results a[aria-selected='true'],
  .site-search__results a:hover { background: rgba(245, 245, 240, 0.08); }
  .site-search__kind {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--signal);
  }
  .site-search__title { font-size: var(--text-sm); font-weight: 600; }
  .site-search__empty { padding: 0.55rem 0.7rem; color: rgba(245, 245, 240, 0.7); font-size: var(--text-sm); }
  @media (max-width: 40em) {
    .site-search__input { width: 100%; }
  }
</style>
