---
/**
 * A notice, not a consent banner: the site sets no cookies of its own and its
 * analytics are cookieless, so there is nothing to consent to. The note says so
 * once and links to the details. Dismissal is remembered with a single
 * localStorage flag (strictly necessary to honour the visitor's own request,
 * never sent anywhere); without JavaScript or storage it simply never shows.
 */
---

<aside class="cookie-note" data-cookie-note hidden aria-labelledby="cookie-note-title">
  <div class="cookie-note__head">
    <span class="cookie-note__mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg>
    </span>
    <p id="cookie-note-title" class="cookie-note__title">No cookies here.</p>
  </div>
  <p class="cookie-note__body">
    This site sets no cookies of its own and tracks no one. Visits are measured with Cloudflare Web Analytics, which is cookieless, so there is nothing to accept.
  </p>
  <div class="cookie-note__actions">
    <button type="button" class="btn btn--primary btn--sm" data-cookie-note-close>Good to know</button>
    <a href="/insights/cookieless-analytics-cloudflare/" class="cookie-note__link">How it works</a>
  </div>
</aside>

<style>
  .cookie-note {
    position: fixed;
    left: var(--gutter);
    bottom: var(--gutter);
    z-index: 60;
    width: min(23rem, calc(100vw - 2 * var(--gutter)));
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid rgba(245, 245, 240, 0.14);
    border-radius: var(--radius-md);
    background: #111;
    color: #f5f5f0;
    box-shadow: 0 24px 48px -24px rgba(0, 0, 0, 0.6);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
  }
  .cookie-note[hidden] { display: none; }
  .cookie-note.is-in { opacity: 1; transform: none; }
  .cookie-note__head { display: flex; align-items: center; gap: var(--space-3); }
  .cookie-note__mark { display: inline-grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; background: rgba(255, 90, 31, 0.14); color: var(--signal); }
  .cookie-note__title { margin: 0; font-weight: 600; font-size: var(--text-base); }
  .cookie-note__body { margin: 0; font-size: var(--text-sm); color: rgba(245, 245, 240, 0.72); line-height: 1.55; }
  .cookie-note__actions { display: flex; align-items: center; gap: var(--space-4); flex-wrap: wrap; }
  .cookie-note__link { font-size: var(--text-sm); color: #f5f5f0; text-underline-offset: 3px; }
  .cookie-note__link:hover { color: var(--signal); }
  @media (prefers-reduced-motion: reduce) { .cookie-note { transition: none; } }
</style>
