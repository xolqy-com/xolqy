---
/**
 * A screenshot of a live site inside a minimal browser frame.
 *
 * The repository holds one master JPEG per project (src/assets/work). Every
 * size and format the page needs is produced on request by Cloudflare Images:
 * the adapter's `imageService: 'cloudflare'` turns each <Image> into a
 * /cdn-cgi/image/ URL, and the edge serves AVIF or WebP at the requested width.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Hostname shown in the frame's address field. */
  host: string;
  /** Rendered widths for the srcset; the master is 1540px wide. */
  widths?: number[];
  sizes: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}

const {
  src,
  alt,
  host,
  widths = [480, 768, 1024, 1540],
  sizes,
  loading = 'lazy',
  fetchpriority = 'auto',
  class: className,
} = Astro.props;
---

<span class:list={['shot', className]}>
  <span class="shot__bar" aria-hidden="true">
    <span class="shot__dots"><i></i><i></i><i></i></span>
    <span class="shot__host">{host}</span>
  </span>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    format="auto"
    quality={82}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    class="shot__img"
  />
</span>

<style>
  .shot {
    --shot-bar: 1.75rem;
    display: block;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    background: var(--bg-raised);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.04) inset;
  }
  .shot__bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: var(--shot-bar);
    padding-inline: var(--space-3);
    border-bottom: 1px solid var(--line);
    background: var(--bg-raised);
  }
  .shot__dots { display: inline-flex; gap: 0.3rem; }
  .shot__dots i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .shot__dots i:first-child { background: var(--signal); }
  .shot__host {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    color: var(--fg-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .shot :global(.shot__img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 11 / 5;
    object-fit: cover;
    object-position: top center;
    background: var(--bg);
  }
</style>
