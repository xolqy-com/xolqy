---
/**
 * The xolqy X symbol: four round-ended arms on the diagonals around a single
 * dot, the "edge" where routes meet. Same geometry as the x of the wordmark,
 * no backgrounds, so it sits on any surface. Below about 20px the gaps close
 * and it reads as a solid x.
 */
interface Props {
  size?: number | string;
  class?: string;
  title?: string;
  color?: string;
}
const { size = 32, class: className, title, color = 'currentColor' } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  width={size}
  height={size}
  class={className}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
>
  {title && <title>{title}</title>}
  <g transform="translate(32 32) rotate(45)" fill="none" stroke={color} stroke-width="9.31" stroke-linecap="round">
    <path d="M0 -26.95V-11.03M0 26.95V11.03M-26.95 0H-11.03M26.95 0H11.03" />
  </g>
  <circle cx="32" cy="32" r="3.11" fill={color} />
</svg>
