---
/**
 * Custom lowercase "xolqy" wordmark. The x is the symbol itself at x-height;
 * o, l, q and y are monoline geometric strokes of the same weight.
 */
interface Props {
  height?: number;
  class?: string;
  title?: string;
}
const { height = 22, class: className, title = 'xolqy' } = Astro.props;
const width = Math.round((height * 98) / 40);
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 98 40"
  width={width}
  height={height}
  class={className}
  role="img"
  aria-label={title}
  focusable="false"
>
  <g transform="translate(10.5 18) rotate(45)">
    <path fill="currentColor" fill-rule="evenodd" d="M-1.9 -13h3.8v26h-3.8z M-13 -1.9h26v3.8h-26z M-0.95 -0.95h1.9v1.9h-1.9z" />
  </g>
  <g fill="none" stroke="currentColor" stroke-width="3.8" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="31.5" cy="18" r="8.1" />
    <path d="M46.5 2V28" />
    <circle cx="61" cy="18" r="8.1" />
    <path d="M69.1 18V36.5" />
    <path d="M78 8.5L86 27" />
    <path d="M94 8.5L82 36.5" />
  </g>
</svg>
