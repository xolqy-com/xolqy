---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/sections/Hero.astro';
import Outcomes from '@/components/sections/Outcomes.astro';
import ServicesLedger from '@/components/sections/ServicesLedger.astro';
import WorkLedger from '@/components/sections/WorkLedger.astro';
import StackExplorer from '@/components/sections/StackExplorer.astro';
import EdgeGlobe from '@/components/sections/EdgeGlobe.astro';
import LabsPreview from '@/components/sections/LabsPreview.astro';
import Process from '@/components/sections/Process.astro';
import Engagements from '@/components/sections/Engagements.astro';
import Faq from '@/components/ui/Faq.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
import { HOME_FAQS } from '@/data/content';
import { SITE } from '@/data/site';
import { faqJsonLd } from '@/lib/seo';
---

<Base
  title="Built for the edge"
  description={SITE.description}
  path="/"
  ogImage="/og/home.png"
  jsonLd={[faqJsonLd([...HOME_FAQS])]}
>
  <Hero />
  <section class="origin-strip" data-theme="dark" aria-label="Our story">
    <div class="container origin-strip__inner">
      <p><span class="mono accent">Our story</span> {SITE.origin}</p>
      <a href="/about/#our-story" class="link">How we got here <span class="arrow" aria-hidden="true">&rarr;</span></a>
    </div>
  </section>
  <Outcomes />
  <ServicesLedger />

  <section class="section" data-theme="light" id="work" aria-labelledby="work-title">
    <div class="container">
      <div class="between reveal">
        <div class="flow">
          <p class="eyebrow">Selected work</p>
          <h2 id="work-title" class="h-3xl measure">Built on Cloudflare, in production.</h2>
        </div>
        <a href="/work/" class="link">All work <span class="arrow" aria-hidden="true">&rarr;</span></a>
      </div>
      <div class="work-wrap reveal" style="--reveal-delay:120ms">
        <WorkLedger variant="compact" />
      </div>
    </div>
  </section>

  <EdgeGlobe theme="dark" />

  <section class="section" data-theme="dark" id="built-on-cloudflare" aria-labelledby="stack-title">
    <div class="container">
      <div class="between reveal">
        <div class="flow">
          <p class="eyebrow">Built on Cloudflare</p>
          <h2 id="stack-title" class="h-3xl measure">How this website actually works.</h2>
        </div>
        <p class="muted stack-note">Every integration below runs this site. Statuses are declared in code and verified live on the <a href="/stack/">stack page</a>.</p>
      </div>
      <div class="stack-wrap reveal" style="--reveal-delay:120ms">
        <StackExplorer variant="compact" />
      </div>
    </div>
  </section>

  <LabsPreview theme="light" />
  <Process theme="dark" />
  <Engagements theme="light" />

  <section class="section" data-theme="dark" id="faqs" aria-labelledby="faq-title">
    <div class="container faq-grid">
      <div class="flow reveal">
        <p class="eyebrow">FAQs</p>
        <h2 id="faq-title" class="h-3xl">Questions we are asked before every project.</h2>
        <p class="muted">Migration scope, WordPress, account ownership, support, platform costs and data location.</p>
      </div>
      <div>
        <Faq items={[...HOME_FAQS]} id="home-faq" />
      </div>
    </div>
  </section>

  <FinalCta theme="light" />
</Base>

<style>
  .origin-strip { border-block: 1px solid var(--line); padding-block: var(--space-5); }
  .origin-strip__inner { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6); align-items: baseline; justify-content: space-between; }
  .origin-strip__inner p { max-width: 80ch; margin: 0; }
  .origin-strip .mono { margin-right: 0.5em; text-transform: uppercase; font-size: var(--text-xs); letter-spacing: var(--tracking-mono); }
  .stack-note { max-width: 40ch; font-size: var(--text-sm); }
  .stack-note a { color: inherit; }
  .stack-wrap { margin-top: var(--space-7); }
  .work-wrap { margin-top: var(--space-7); }
  .faq-grid { display: grid; gap: var(--space-7); align-items: start; }
  .faq-grid > .flow { max-width: 28ch; }
  @media (min-width: 60em) {
    .faq-grid { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--gutter); }
    .faq-grid > .flow { position: sticky; top: 6rem; }
  }
</style>
