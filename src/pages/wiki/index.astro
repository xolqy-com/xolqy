---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import SectionIntro from '@/components/ui/SectionIntro.astro';
import { breadcrumbJsonLd, definedTermSetJsonLd, formatDate } from '@/lib/seo';

const CATEGORIES = ['Compute', 'Data', 'AI', 'Security', 'Delivery', 'Platform', 'Concepts'] as const;
const BLURB: Record<(typeof CATEGORIES)[number], string> = {
  Compute: 'Where code runs: Workers, assets, coordination, background work and the tooling around them.',
  Data: 'Where data lives: relational records, key-value configuration, files and vectors.',
  AI: 'Models, gateways and retrieval, with the concepts that make an assistant trustworthy.',
  Security: 'What stands in front of a site and who gets through.',
  Delivery: 'DNS, caching, routing, images, email and the numbers that show whether it works.',
  Platform: 'Account-level products and settings.',
  Concepts: 'Terms that come up in every proposal, explained once.',
};

const entries = (await getCollection('wiki', ({ data }) => !data.draft)).sort((a, b) => a.data.term.localeCompare(b.data.term));
const services = await getCollection('services', ({ data }) => !data.draft);
const serviceTitle = (slug: string) => services.find((s) => s.id === slug)?.data.shortTitle ?? slug;
const groups = CATEGORIES.map((c) => ({ category: c, items: entries.filter((e) => e.data.category === c) })).filter((g) => g.items.length > 0);
const latest = entries.reduce((d, e) => (e.data.updatedAt > d ? e.data.updatedAt : d), entries[0]!.data.updatedAt);
const description = `${entries.length} short, factual entries on Cloudflare products and terms: what each one is, when to use it, what it costs, and which Xolqy service it belongs to.`;
---

<Base
  title="Cloudflare wiki"
  description={description}
  path="/wiki/"
  ogImage="/og/wiki.png"
  jsonLd={[breadcrumbJsonLd([{ name: 'Home', href: '/' }, { name: 'Wiki', href: '/wiki/' }]), definedTermSetJsonLd(entries.map((e) => ({ name: e.data.term, path: `/wiki/${e.id}/` })))]}
>
  <section class="section" data-theme="dark">
    <div class="container">
      <SectionIntro eyebrow="Wiki" title="Cloudflare, one term at&nbsp;a&nbsp;time." id="wiki-title" level="h1">
        <p class="lead">What each product is, when to use it, what it costs and where it fits in our services. Written for business owners and engineers alike, checked against Cloudflare's documentation, last reviewed {formatDate(latest)}.</p>
      </SectionIntro>
    </div>
  </section>

  <section class="section" data-theme="light" aria-labelledby="wiki-list-title">
    <div class="container">
      <div class="wiki-tools reveal">
        <label class="wiki-search">
          <span class="mono faint">Filter</span>
          <input type="search" data-wiki-filter placeholder="Type a product or a term, for example D1, cache, Access" autocomplete="off" spellcheck="false" />
        </label>
        <p class="mono faint" data-wiki-count aria-live="polite">{entries.length} entries</p>
      </div>
      <h2 id="wiki-list-title" class="visually-hidden">All entries</h2>

      {groups.map((g) => (
        <section class="wiki-group" data-wiki-group aria-labelledby={`wiki-${g.category.toLowerCase()}`}>
          <div class="between wiki-group__head reveal">
            <div class="flow">
              <p class="eyebrow">{g.category}</p>
              <h3 id={`wiki-${g.category.toLowerCase()}`} class="h-2xl">{BLURB[g.category]}</h3>
            </div>
          </div>
          <ul class="list-reset wiki-grid">
            {g.items.map((e, i) => (
              <li class="wiki-card reveal" style={`--reveal-delay:${Math.min(i, 6) * 50}ms`} data-wiki-item data-wiki-text={`${e.data.term} ${e.data.summary} ${e.data.related.join(' ')}`.toLowerCase()}>
                <a href={`/wiki/${e.id}/`} class="wiki-card__link">
                  <span class="wiki-card__term h-xl">{e.data.term}</span>
                  <span class="muted wiki-card__summary">{e.data.summary}</span>
                  {e.data.pillars.length > 0 && (
                    <span class="wiki-card__pillars mono--lc faint">Pillar: {e.data.pillars.map(serviceTitle).join(', ')}</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <p class="muted wiki-empty" data-wiki-empty hidden>No entry matches that. Try a product name, or <a href="/contact/">ask us</a>.</p>
    </div>
  </section>

  <section class="section" data-theme="dark">
    <div class="container between reveal">
      <div class="flow">
        <p class="eyebrow">Missing a term?</p>
        <h2 class="h-3xl">Tell us what you were looking for.</h2>
      </div>
      <a href="/contact/" class="btn btn--primary">Ask a question <span class="arrow" aria-hidden="true">&rarr;</span></a>
    </div>
  </section>

  <script src="../../scripts/wiki.ts"></script>
</Base>

<style>
  .wiki-tools { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--space-4); flex-wrap: wrap; }
  .wiki-search { display: grid; gap: var(--space-2); flex: 1 1 24rem; max-width: 40rem; }
  .wiki-search input {
    width: 100%;
    font: inherit;
    font-size: var(--text-base);
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
  }
  .wiki-search input:focus-visible { outline: 2px solid var(--signal); outline-offset: 2px; }
  .wiki-group { margin-top: var(--space-8); }
  .wiki-group[hidden] { display: none; }
  .wiki-group__head .flow { max-width: 56ch; }
  .wiki-grid { margin-top: var(--space-6); display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .wiki-card[hidden] { display: none; }
  .wiki-card__link {
    display: grid; gap: var(--space-2); align-content: start;
    height: 100%;
    padding: var(--space-5);
    background: var(--bg);
    text-decoration: none;
    transition: background-color var(--dur-base);
  }
  .wiki-card__link:hover { background: var(--bg-raised); }
  .wiki-card__link:hover .wiki-card__term { color: var(--accent-text); }
  .wiki-card__term { display: block; transition: color var(--dur-fast); }
  .wiki-card__summary { font-size: var(--text-sm); }
  .wiki-card__pillars { font-size: 0.8125rem; }
  .wiki-empty { margin-top: var(--space-7); }
  .wiki-empty a { color: inherit; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (min-width: 48em) { .wiki-grid { grid-template-columns: repeat(2, 1fr); } .wiki-card:last-child:nth-child(odd) { grid-column: 1 / -1; } }
  @media (min-width: 60em) {
    .wiki-grid { grid-template-columns: repeat(3, 1fr); }
    .wiki-card:last-child:nth-child(odd) { grid-column: auto; }
    .wiki-card:last-child:nth-child(3n + 1) { grid-column: 1 / -1; }
    .wiki-card:last-child:nth-child(3n + 2) { grid-column: 2 / -1; }
  }
</style>
