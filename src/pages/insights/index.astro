---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import SectionIntro from '@/components/ui/SectionIntro.astro';
import PromoBanner from '@/components/ui/PromoBanner.astro';
import { insightHref } from '@/lib/insights';
import { breadcrumbJsonLd, formatDate } from '@/lib/seo';

// Drafts never reach the public index. Research has its own index and badge.
const published = (await getCollection('insights', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const posts = published.filter((p) => p.data.type !== 'research');
const research = published.filter((p) => p.data.type === 'research').sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
const hubs = research
  .filter((p) => p.data.researchRole === 'hub')
  .sort((a, b) => a.data.publishedAt.getTime() - b.data.publishedAt.getTime() || a.id.localeCompare(b.id));
const hub = hubs[0];
const seriesCount = hub ? research.filter((p) => p.data.series === hub.data.series).length : 0;
const laterHubs = hubs.slice(1);
const description = 'Technical and business articles on running a business on Cloudflare, plus long-form research. The first research series compares Cloudflare with the rest of the edge-cloud landscape.';
---

<Base
  title="Insights"
  description={description}
  path="/insights/"
  ogImage="/og/insights.png"
  jsonLd={[breadcrumbJsonLd([{ name: 'Home', href: '/' }, { name: 'Insights', href: '/insights/' }])]}
>
  <section class="section" data-theme="dark">
    <div class="container">
      <SectionIntro eyebrow="Insights" title="Notes from building on&nbsp;Cloudflare." id="insights-title" level="h1">
        <p class="lead">Technical and business articles, plus <a href="/insights/research/">research</a> when a question needs a comparison rather than a how-to. Written to be useful whether or not you ever hire us. The <a href="/cloudflare-os/">Cloudflare OS</a> series is the map; the <a href="/wiki/">wiki</a> defines the products.</p>
      </SectionIntro>
    </div>
  </section>

  <section class="section" data-theme="light">
    <div class="container insights-layout">
      <div class="insights-main">
      {hub && (
        <article class="research-feature reveal">
          <div class="research-feature__meta">
            <a class="badge badge--research" href="/insights/research/">Research</a>
            <span class="mono faint">{seriesCount} {seriesCount === 1 ? 'piece' : 'pieces'} in the series</span>
          </div>
          <h2 class="h-2xl"><a href={insightHref(hub)}>{hub.data.title}</a></h2>
          <p class="muted">{hub.data.description}</p>
          <p class="research-feature__more">
            <a href="/insights/research/" class="link">The research index <span class="arrow" aria-hidden="true">&rarr;</span></a>
          </p>
          {laterHubs.map((item) => (
            <p class="research-feature__more">
              <a href={insightHref(item)} class="link">{item.data.title} <span class="arrow" aria-hidden="true">&rarr;</span></a>
            </p>
          ))}
        </article>
      )}
      <ol class="list-reset posts">
        {posts.map((p, i) => (
          <li class="posts__item reveal" style={`--reveal-delay:${i * 60}ms`}>
            <a href={insightHref(p)} class="posts__link">
              <div class="posts__meta mono faint">
                <time datetime={p.data.publishedAt.toISOString()}>{formatDate(p.data.publishedAt)}</time>
                <span>{p.data.readingMinutes} min</span>
                <span>{p.data.audience === 'both' ? 'Business + technical' : p.data.audience}</span>
              </div>
              <h2 class="h-2xl posts__title">{p.data.title}</h2>
              <p class="muted posts__desc">{p.data.description}</p>
              <ul class="list-reset cluster">
                {p.data.topics.map((t) => <li class="badge">{t}</li>)}
              </ul>
            </a>
          </li>
        ))}
      </ol>
      </div>
      <aside class="insights-ad">
        <PromoBanner />
      </aside>
    </div>
  </section>
</Base>

<style>
  .research-feature {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-7);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--signal);
    max-width: 76ch;
  }
  .research-feature__meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); }
  .research-feature h2 a { text-decoration: none; }
  .research-feature h2 a:hover { color: var(--signal); }
  .research-feature__more { margin-top: var(--space-2); }
  .posts { display: grid; border-top: 1px solid var(--line); }
  .posts__item { border-bottom: 1px solid var(--line); }
  .posts__link { display: grid; gap: var(--space-4); padding-block: var(--space-7); text-decoration: none; max-width: 76ch; }
  .posts__link:hover .posts__title { color: var(--signal); }
  .posts__meta { display: flex; flex-wrap: wrap; gap: var(--space-4); }
  .posts__title { transition: color var(--dur-fast); }
  .insights-ad { display: none; }
  @media (min-width: 80em) {
    .insights-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: var(--gutter);
      align-items: start;
    }
    .insights-ad {
      display: block;
      position: sticky;
      top: 6rem;
      justify-self: end;
    }
  }
</style>
