---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PromoBanner from '@/components/ui/PromoBanner.astro';
import { insightHref } from '@/lib/insights';
import { breadcrumbJsonLd, articleJsonLd, formatDate } from '@/lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('insights', ({ data }) => !data.draft && data.type === 'research');
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const services = (await getCollection('services', ({ data }) => !data.draft)).filter((s) => post.data.relatedServices.includes(s.id));
const series = (await getCollection('insights', ({ data }) => !data.draft && data.type === 'research' && data.series === post.data.series))
  .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
const path = insightHref(post);
const ogImage = `/og/insight-${post.id}.png`;
const toc = headings.filter((h) => h.depth === 2);
const roleLabel = post.data.researchRole === 'hub' ? 'Flagship' : 'Comparison';
const sourcesLabel = post.data.sourcesAt ? formatDate(post.data.sourcesAt) : '9 October 2026';
---

<Base
  title={post.data.title}
  description={post.data.description}
  path={path}
  ogImage={ogImage}
  ogType="article"
  jsonLd={[
    breadcrumbJsonLd([
      { name: 'Home', href: '/' },
      { name: 'Insights', href: '/insights/' },
      { name: 'Research', href: '/insights/research/' },
      { name: post.data.title, href: path },
    ]),
    articleJsonLd({ title: post.data.title, description: post.data.description, path, publishedAt: post.data.publishedAt, updatedAt: post.data.updatedAt, image: ogImage }),
  ]}
>
  <article>
    <header class="section post-head" data-theme="dark">
      <div class="container">
        <p class="eyebrow fade-in">
          <a href="/insights/" class="post-head__crumb">Insights</a>
          <span aria-hidden="true"> / </span>
          <a href="/insights/research/" class="post-head__crumb">Research</a>
        </p>
        <p class="post-head__badges fade-in" style="--d:40ms">
          <span class="badge badge--research">Research</span>
          <span class="mono faint">{roleLabel}</span>
        </p>
        <h1 class="h-3xl shade post-head__title"><span class="hero-line"><span style="--d:60ms">{post.data.title}</span></span></h1>
        <p class="lead fade-in" style="--d:240ms">{post.data.description}</p>
        <p class="mono faint post-head__meta fade-in" style="--d:360ms">
          <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
          {post.data.updatedAt && <span> · Updated <time datetime={post.data.updatedAt.toISOString()}>{formatDate(post.data.updatedAt)}</time></span>}
          <span> · {post.data.readingMinutes} min read</span>
          <span> · Sources dated {sourcesLabel}</span>
        </p>
      </div>
    </header>

    <div class="section post-body" data-theme="light">
      <div class="container post-body__grid">
        <aside class="post-toc">
          <p class="mono faint">On this page</p>
          <ol class="list-reset post-toc__list">
            {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
          </ol>
          {series.length > 1 && (
            <nav class="series-nav" aria-label="In this research">
              <p class="mono faint">In this research</p>
              <ol class="list-reset post-toc__list">
                {series.map((item) => (
                  <li>
                    <a href={insightHref(item)} aria-current={item.id === post.id ? 'page' : undefined}>
                      {item.data.researchRole === 'hub' ? 'Hub' : item.data.title.replace(/^Cloudflare vs /, '')}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )}
        </aside>
        <div class="prose post-prose">
          <Content />
        </div>
        <aside class="post-ad">
          <PromoBanner />
        </aside>
      </div>
    </div>

    <footer class="section" data-theme="dark">
      <div class="container post-foot">
        <div class="flow">
          <p class="eyebrow">Cloudflare OS by Xolqy</p>
          <h2 class="h-2xl">The comparison is the reading. The work is the system.</h2>
          <p>Cloudflare OS is Cloudflare’s open-source workspace. <a href="/cloudflare-os/">Cloudflare OS Implementation by Xolqy</a> is the pilot and the Cloudflare-first build, in an account you own. Xolqy is an independent implementation partner. The published packages are unchanged: the <a href="/shop/#cloudflare-os">implementation package</a> and the <a href="/shop/#os-introduction">€600 introduction</a>.</p>
          <div class="cluster">
            <a href="/cloudflare-os/" class="btn btn--primary">Cloudflare OS by Xolqy <span class="arrow" aria-hidden="true">&rarr;</span></a>
            <a href="/contact/" class="btn btn--ghost">Start your project</a>
          </div>
        </div>
        <div class="flow">
          <p class="eyebrow">Related services</p>
          <ul class="list-reset post-foot__services">
            {services.map((s) => (
              <li><a href={`/services/${s.id}/`} class="link">{s.data.title} <span class="arrow" aria-hidden="true">&rarr;</span></a></li>
            ))}
            <li><a href="/insights/" class="link">All insights <span class="arrow" aria-hidden="true">&rarr;</span></a></li>
            <li><a href="/insights/research/" class="link">Research index <span class="arrow" aria-hidden="true">&rarr;</span></a></li>
          </ul>
        </div>
      </div>
    </footer>
  </article>
</Base>

<style>
  .post-head { padding-block: clamp(3rem, 7vw, 6rem); }
  .post-head .container { display: grid; gap: var(--space-5); max-width: 1080px; }
  .post-head__crumb { color: inherit; }
  .post-head__badges { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); }
  .post-head__title { max-width: 22ch; }
  .post-body__grid { display: grid; gap: var(--space-7); max-width: 1080px; }
  .post-ad { display: none; }
  .post-toc { display: grid; gap: var(--space-3); align-content: start; }
  .series-nav { display: grid; gap: var(--space-3); margin-top: var(--space-6); padding-top: var(--space-5); border-top: 1px solid var(--line); }
  .post-toc__list { display: grid; gap: var(--space-2); font-size: var(--text-sm); }
  .post-toc__list a { text-decoration: none; color: var(--fg-muted); }
  .post-toc__list a:hover { color: var(--accent-hover); }
  .post-toc__list a[aria-current='page'] { color: var(--fg); font-weight: 600; }
  .post-prose { font-size: var(--text-lg); min-width: 0; max-width: none; }
  .post-toc { min-width: 0; }
  .post-prose :global(h2) { scroll-margin-top: 6rem; }
  .post-prose :global(.research-summary) {
    background: var(--ink);
    color: var(--paper);
    padding: var(--space-6);
    border-left: 4px solid var(--signal);
    margin-top: 0.75em;
  }
  .post-prose :global(.research-summary p) { color: var(--paper); }
  .post-prose :global(.research-summary p + p) { margin-top: 0.9em; }
  .post-prose :global(.research-summary a) { color: var(--signal); }
  .post-prose :global(.diagram) {
    margin-top: 0.75em;
    overflow-x: auto;
    border: 1px solid var(--line);
    background: var(--paper-2);
    padding: var(--space-5) var(--space-4);
  }
  .post-prose :global(.diagram svg) {
    width: 640px;
    max-width: none;
    height: auto;
    margin-inline: auto;
  }
  .post-prose :global(.diagram figcaption) {
    max-width: 640px;
    margin-inline: auto;
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .post-prose :global(.matrix) { margin-top: 0.75em; }
  .post-prose :global(.matrix th:first-child),
  .post-prose :global(.matrix td:first-child) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .post-prose :global(.refs) {
    list-style: none;
    padding-left: 0;
    font-size: var(--text-sm);
    counter-reset: ref;
  }
  .post-prose :global(.refs li) {
    counter-increment: ref;
    position: relative;
    padding-left: 2.75rem;
    padding-top: 0.85rem;
    margin-top: 0;
    border-top: 1px solid var(--line);
  }
  .post-prose :global(.refs li)::before {
    content: "[" counter(ref) "]";
    position: absolute;
    left: 0;
    top: 0.95rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent-text);
  }
  .post-foot { display: grid; gap: var(--space-7); }
  .post-foot__services { display: grid; gap: var(--space-3); }
  .post-foot a:not(.btn):not(.link) { color: var(--signal); }
  @media (min-width: 60em) {
    .post-body__grid { grid-template-columns: 15rem minmax(0, 1fr); gap: var(--gutter); max-width: none; }
    .post-toc { position: sticky; top: 6rem; }
    .post-foot { grid-template-columns: 1.4fr 1fr; gap: var(--gutter); align-items: start; }
  }
  @media (min-width: 80em) {
    .post-body__grid {
      max-width: none;
      grid-template-columns: 15rem minmax(0, 1fr) 300px;
      align-items: start;
    }
    .post-ad {
      display: block;
      position: sticky;
      top: 6rem;
      justify-self: end;
    }
  }
</style>
