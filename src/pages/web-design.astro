---
import { getCollection } from 'astro:content';
import ServicePage from '@/components/services/ServicePage.astro';
import { serviceHref } from '@/lib/service-href';

const all = (await getCollection('services', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const service = all.find((s) => s.id === 'web-design');
if (!service) throw new Error('Missing services collection entry: web-design');
const idx = all.findIndex((s) => s.id === service.id);
const prev = all[(idx - 1 + all.length) % all.length]!;
const next = all[(idx + 1) % all.length]!;
---

<ServicePage service={service} prev={prev} next={next} path={serviceHref(service.id)} />
