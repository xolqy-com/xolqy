// Cloudflare Workers configuration for xolqy.com.
//
// Everything in this file is APPLICATION configuration that travels with the
// code. Settings that must be made in the Cloudflare dashboard (DNS, TLS, WAF,
// Access, Turnstile widgets, AI Gateway, Email Service domain onboarding, Web
// Analytics) are listed in README.md under "Dashboard configuration".
//
// Resource IDs: run `scripts/provision.sh` (or the commands in README.md) once
// per account, then paste the printed IDs below.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xolqy",
  // Wooprodigy@gmail.com's account; pinned so wrangler never asks which of the
  // user's accounts to deploy to.
  "account_id": "b12bc31e1898e5bf3ba4acfb4becea21",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  // No scheduled handler. The empty list also removes the cron trigger left
  // behind by the Worker that previously ran under this name.
  "triggers": { "crons": [] },

  // Static assets are produced by `astro build` (prerendered pages, CSS, fonts,
  // client scripts). The adapter fills in the output directory at build time.
  //
  // run_worker_first: with a compatibility date on or after 2025-04-01,
  // navigation requests (Sec-Fetch-Mode: navigate) that match no asset are
  // answered by the asset layer's 404 page WITHOUT invoking the Worker. The
  // on-demand routes below must therefore be routed to the Worker explicitly,
  // otherwise opening /api/status or /admin/ in a browser shows the 404 page.
  "assets": {
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },

  // Operational visibility: Workers Logs + invocation logs (dashboard:
  // Workers & Pages > xolqy > Observability).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true }
  },

  // Plain (non-secret) runtime variables. Secrets are set with
  // `wrangler secret put <NAME>` and mirrored in `.dev.vars` for local work.
  "vars": {
    "SITE_URL": "https://xolqy.com",
    // Expected hostname(s) for Turnstile siteverify checks, comma separated.
    "TURNSTILE_HOSTNAMES": "xolqy.com,www.xolqy.com",
    // Staff notification target and verified sender for Cloudflare Email Service.
    // notify.xolqy.com is onboarded for sending (the apex keeps its existing mail host).
    // Every accepted enquiry is delivered to NOTIFY_EMAIL by the EnquiryWorkflow.
    "NOTIFY_EMAIL": "it@symbols.gr",
    "EMAIL_FROM": "noreply@notify.xolqy.com",
    "EMAIL_FROM_NAME": "Xolqy",
    // Send a short acknowledgement to the person who enquired ("true"/"false").
    "ENQUIRY_ACK": "false",
    // Cloudflare Access (Zero Trust) protection for /admin/. Both must be set
    // in production or the staff view fails closed.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // AI Gateway id (AI > AI Gateway). Empty = direct Workers AI calls.
    "AI_GATEWAY_ID": "xolqy",
    "AI_CHAT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_EMBED_MODEL": "@cf/baai/bge-base-en-v1.5"
  },

  // ---- Data -----------------------------------------------------------------
  // D1: the authoritative store for accepted enquiries and their processing status.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xolqy-site",
      "database_id": "5845ab5b-370d-454b-adc8-e2a549457c90",
      "migrations_dir": "migrations"
    }
  ],

  // KV: public configuration and read-heavy cached data only. Never the
  // authoritative enquiry store (KV is eventually consistent).
  "kv_namespaces": [
    { "binding": "CONFIG", "id": "f81dbc9a67bc4ad69439eef73725eb2e" }
  ],

  // R2: downloadable resources (served through /api/resources/<key>).
  "r2_buckets": [
    { "binding": "RESOURCES", "bucket_name": "xolqy-resources" }
  ],

  // ---- Asynchronous processing ---------------------------------------------
  // Queue: decouples form acceptance from processing. The consumer starts one
  // Workflow instance per enquiry (idempotent by enquiry id).
  "queues": {
    "producers": [
      { "queue": "xolqy-enquiries", "binding": "ENQUIRY_QUEUE" }
    ],
    "consumers": [
      {
        "queue": "xolqy-enquiries",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "xolqy-enquiries-dlq"
      }
    ]
  },

  // Workflow: durable, retried, multi-step processing of each enquiry
  // (load, mark, notify staff, optional acknowledgement, finalise).
  "workflows": [
    {
      "name": "xolqy-enquiry",
      "binding": "ENQUIRY_WORKFLOW",
      "class_name": "EnquiryWorkflow"
    }
  ],

  // ---- AI --------------------------------------------------------------------
  // Workers AI (embeddings + chat) and Vectorize (approved service content).
  // Both have no local simulation; set `"remote": true` on each for `astro dev`
  // against the real services after `wrangler login`.
  "ai": { "binding": "AI" },
  "vectorize": [
    { "binding": "VECTORIZE", "index_name": "xolqy-knowledge" }
  ],

  // Durable Object: one bounded AI conversation session per visitor session.
  "durable_objects": {
    "bindings": [
      { "name": "FINDER_SESSION", "class_name": "FinderSession" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FinderSession"] }
  ],

  // ---- Abuse protection -------------------------------------------------------
  // Rate limiting binding (per Cloudflare location, keyed by client IP).
  "ratelimits": [
    { "name": "ENQUIRY_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "FINDER_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],

  // ---- Email -----------------------------------------------------------------
  // Cloudflare Email Service (sending is in beta on the Workers Paid plan).
  // Requires the sending domain to be onboarded in the dashboard first.
  "send_email": [
    { "name": "EMAIL" }
  ]
}
