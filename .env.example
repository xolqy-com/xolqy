# Build-time public variables (inlined into prerendered pages by astro:env).
# Copy to `.env` for local development. In Cloudflare Workers Builds, set these
# as build variables (Settings > Build > Variables and secrets).

# Turnstile sitekey. The value below is Cloudflare's documented TEST sitekey
# that always passes; replace with the real widget sitekey for xolqy.com.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Cloudflare Web Analytics beacon token. Leave empty to omit the beacon.
PUBLIC_CF_BEACON_TOKEN=
