# Build-time public variables (inlined into prerendered pages by astro:env).
# Copy to `.env` for local development. In Cloudflare Workers Builds, set these
# as build variables (Settings > Build > Variables and secrets).

# Turnstile sitekey. For local development use Cloudflare's documented TEST
# sitekey 1x00000000000000000000AA (always passes). Production widget
# "xolqy.com enquiry form": 0x4AAAAAAFPXpOox5sO1wCbR
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Cloudflare Web Analytics beacon token (site xolqy.com, manual setup).
# Leave empty locally to omit the beacon. Production: 6048606bc96843f1898529a3608944f3
PUBLIC_CF_BEACON_TOKEN=
